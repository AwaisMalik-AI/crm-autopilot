# Copy to .env and fill in real values. Never commit .env.

# Database (async SQLAlchemy — use +asyncpg for PostgreSQL)
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm_autopilot

# Redis (Celery broker + result backend if not overridden)
REDIS_URL=redis://localhost:6379/0

# App secrets (generate strong random values)
SECRET_KEY=change-me-minimum-32-characters-long-random-string
WEBHOOK_SECRET=change-me-webhook-hmac-secret-16chars-min

# Optional: override Celery (defaults to REDIS_URL)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional LLM for lead score narrative (OpenAI-compatible /chat/completions)
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Default SMTP (per-mailbox settings live on EmailAccount)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

EMAIL_DAILY_LIMIT=50
WARMUP_ENABLED=true

# Lead scoring tuning
IDEAL_TITLE_KEYWORDS=founder,ceo,cto,director,head,vp,owner
IDEAL_COMPANY_KEYWORDS=saas,software,agency,consulting,tech

# Dev only: create tables on API startup
# INIT_DB_ON_STARTUP=true

# CORS (comma-separated origins; * for dev)
CORS_ORIGINS=*
